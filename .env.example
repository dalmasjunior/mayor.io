# CIDADE.io MVP — environment variables (example)
# Copy to .env for LOCAL development only. NEVER commit a real .env.
# On Render/Railway, PORT is injected automatically — do NOT set it yourself.

# Port the server listens on. Locally defaults to 3000 if unset.
# On hosting platforms this is provided automatically.
# PORT=3000

# Host interface to bind. Defaults to 0.0.0.0 (required by most PaaS).
# HOST=0.0.0.0

# Node environment.
NODE_ENV=production

# --- Optional gameplay tuning (server has safe defaults; leave unset normally) ---
# Playing time between elections, in ms (default 70000).
# ROUND_PLAY_MS=70000

# Total match length, in ms (default 360000 = 6 minutes).
# MATCH_MS=360000

# XP needed to reach level 2 (default 30).
# XP_BASE=30
